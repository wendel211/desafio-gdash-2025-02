# ==============================================
# 🔧 CONFIGURAÇÕES DO PROJETO GDASH
# ==============================================

# ----------------------------------------------
# 🌐 API (NestJS)
# ----------------------------------------------
API_PORT=3000
API_JWT_SECRET=supersecret123
API_DEFAULT_ADMIN_EMAIL=admin@gdash.com
API_DEFAULT_ADMIN_PASSWORD=123456

# ----------------------------------------------
# 🗄️ BANCO DE DADOS (MongoDB)
# ----------------------------------------------
MONGO_URI=mongodb://mongo:27017/gdash
MONGO_DB=gdash

# ----------------------------------------------
# 🎨 FRONTEND (React + Vite)
# ----------------------------------------------
VITE_API_URL=http://localhost:3000/api

# ----------------------------------------------
# 🐇 RABBITMQ (Message Broker)
# ----------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
QUEUE_NAME=weather_queue

# ----------------------------------------------
# 🐍 COLLECTOR (Python - Coleta de dados)
# ----------------------------------------------
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
CITY_LAT=-12.27
CITY_LON=-38.97
COLLECTOR_INTERVAL=3600

# Parâmetros da API (não alterar)
WEATHER_PARAMS=temperature_2m,relative_humidity_2m,wind_speed_10m

# ----------------------------------------------
# ⚙️ WORKER (Go - Consumidor da fila)
# ----------------------------------------------
API_URL=http://api:3000/api

# ----------------------------------------------
# 🤖 AI SERVICE (Python + OpenAI)
# ----------------------------------------------
# ⚠️ OBRIGATÓRIO: Obtenha sua chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL interna da API NestJS (não alterar)
NEST_API_URL=http://api:3000

# URL do AI Service para a API (não alterar)
AI_URL=http://ai-service:8001

# ==============================================
# 📋 INSTRUÇÕES:
# ==============================================
# 1. Copie este arquivo para .env
# 2. Configure sua OPENAI_API_KEY
# 3. Ajuste CITY_LAT e CITY_LON para sua localização
# 4. Execute: docker-compose up -d --build
# ==============================================